---
import Layout from '@/layouts/Layout.astro';
import { ConvertPanel } from '@/ui/components/ConvertPanel';
import { CONVERTERS } from '@/lib/converters';

export async function getStaticPaths() {
  return CONVERTERS.map((c) => ({
    params: {
      from: c.from.toLowerCase(),
      to: c.to.toLowerCase(),
    },
  }));
}

const { from, to } = Astro.params;
const targetExt = `.${to}`;
---

<Layout
  title={`Converter ${from?.toUpperCase()} para ${to?.toUpperCase()} - FileTools`}
  description={`Converta arquivos de ${from?.toUpperCase()} para ${to?.toUpperCase()} com aceleração local no navegador, sem upload de arquivos.`}
>
  <div class="mx-auto max-w-5xl">
    <h1 class="text-[15px] font-medium tracking-tight text-foreground">
      Converter {from?.toUpperCase()} para {to?.toUpperCase()}
    </h1>
    <p class="mt-1 text-[13px] text-muted-foreground">
      Converta seu arquivo {from?.toUpperCase()} para {to?.toUpperCase()} rapidamente com aceleração de hardware (GPU ou CPU multi-thread).
    </p>
    <div class="mt-6">
      <ConvertPanel client:load fixedTarget={targetExt} accept={`.${from}`} />
    </div>
  </div>
</Layout>
