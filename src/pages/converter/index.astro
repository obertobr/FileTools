---
/**
 * src/pages/converter/index.astro
 * Converter Catalog - SEO page listing all available conversions.
 */
import Layout from '@/layouts/Layout.astro';
import { ConverterCatalog } from '@/ui/views/ConverterCatalog';
---

<Layout
  title="Conversores - FileTools"
  description="Navegue por todos os conversores disponíveis no FileTools: vídeo, áudio, imagem e documentos."
  activePath="/converter"
>
  <div class="mx-auto max-w-5xl">
    <h1 class="text-[15px] font-medium tracking-tight text-foreground">Conversores</h1>
    <p class="mt-1 text-[13px] text-muted-foreground">
      Converta arquivos entre os formatos mais populares sem nenhum upload.
    </p>
    <div class="mt-6">
      <ConverterCatalog client:load />
    </div>
  </div>
</Layout>
