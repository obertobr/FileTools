---
/**
 * src/pages/converter/[slug].astro
 * Dynamic SSG route generator for /converter/[from]-para-[to] pages.
 *
 * Astro calls getStaticPaths() at build time to enumerate all valid routes.
 * Each route is a fully-rendered static HTML page with the ConvertPanel island
 * pre-configured for the specific from→to conversion.
 *
 * URL format: /converter/mp4-para-mp3, /converter/docx-para-html, etc.
 * (PT-BR slug convention per ARCHITECTURE.MD §2)
 */
import '@/styles/global.css';
import { CONVERTERS, findConverter } from '@/lib/formats';
import { Navbar } from '@/ui/components/Navbar';
import { ConvertPanel } from '@/ui/components/ConvertPanel';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  // Build one static page per converter entry.
  // Deduplication is handled by the CONVERTERS array itself (no duplicate slugs).
  return CONVERTERS.map((converter) => ({
    params: { slug: converter.slug },
    props: { converter },
  }));
}) satisfies GetStaticPaths;

const { converter } = Astro.props;
const { slug } = Astro.params;
const pathname = `/converter/${slug}`;

const title = `Converter ${converter.from} para ${converter.to} — FileTools`;
const description = `${converter.description}. Grátis, offline, sem upload.`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={`https://filetools.app/converter/${slug}`} />
    <!-- PWA -->
    <meta name="theme-color" content="#1f2937" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <Navbar activePath={pathname} client:load />
    <main class="mx-auto max-w-2xl px-4 pb-24 pt-12">
      <a
        href="/converter"
        class="focus-ring inline-flex items-center gap-1 rounded-sm text-[12px] text-muted-foreground transition-colors hover:text-foreground"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        Conversores
      </a>

      <h1 class="mt-4 text-[15px] font-medium tracking-tight">
        Converter {converter.from} para {converter.to}
      </h1>
      <p class="mt-1 text-[13px] text-muted-foreground">{converter.description}.</p>

      <div class="mt-6">
        <ConvertPanel
          fixedTarget={converter.to}
          accept={`.${converter.from.toLowerCase()}`}
          hint={`Esperado: arquivo .${converter.from.toLowerCase()}`}
          client:load
        />
      </div>
    </main>
  </body>
</html>
